{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JELICA Result Package Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "content_id",
    "producer",
    "package_created_at",
    "task",
    "stages",
    "artifacts"
  ],
  "properties": {
    "format": {
      "const": "jelica-result-package"
    },
    "format_version": {
      "const": "1.0"
    },
    "content_id": {
      "$ref": "#/$defs/contentId"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "JELICA"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package_created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "created_at",
        "completed_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "completed_with_warnings"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "artifacts"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/protectedArtifactPath"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/protectedArtifactPath"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/digestHex"
          }
        }
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "task.json"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "configuration.json"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "input/input_manifest.json"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "input/normalized_sequences.fasta"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digestHex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!\\.?$)(?!\\.\\.$)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "protectedArtifactPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "not": {
            "const": "manifest.json"
          }
        },
        {
          "not": {
            "const": "NOTES.txt"
          }
        }
      ]
    }
  }
}
