DOMAIN=localhost
WEB_FRONTEND_UPSTREAM=web-frontend:3000
WEB_BACKEND_UPSTREAM=web-backend:8000
WEB_APP_API_BASE_URL=http://web-backend:8000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_NAME=JELICA Web
NEXT_PUBLIC_DEFAULT_THEME=light
# Existing host directory containing one validated bundle or a release tree.
JELICA_DOCUMENTATION_RELEASES_PATH=../../docs/documentation/releases
# Optional exact bundle path inside the read-only container mount. Pin this when the tree contains
# more than one bundle with the same locale, profile, and text-size selection.
JELICA_DOCUMENTATION_RELEASE_DIR=
API_HOST=0.0.0.0
API_PORT=8000
AUTH_COOKIE_SECURE=false
# Development only: opt in to logging and API exposure of email verification tokens.
AUTH_EXPOSE_DEV_TOKENS=false
EMAIL_DELIVERY_MODE=development
PUBLIC_WEB_BASE_URL=http://localhost

POSTGRES_USER=jelica
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jelica_web

DATABASE_URL=postgresql+psycopg://jelica:change-me-in-production@web-db:5432/jelica_web
WEB_SECRET_KEY=replace-with-random-value

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JELICA Web Backend
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=15
PASSWORD_RESET_TTL_SECONDS=3600

# Operator-only API. Keep disabled publicly; if enabled, set a long random token and call the
# backend only from its container/private network with X-JELICA-Internal-Token.
INTERNAL_API_ENABLED=false
INTERNAL_API_TOKEN=

# Optional Web Push VAPID configuration. Provide all three values together.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Optional Telegram Bot API integration. Provide all three values together; backend only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT_SECONDS=10

# Single-worker in-memory auth throttling. A multi-worker deployment requires shared state.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_CLIENT=60
AUTH_RATE_LIMIT_LOGIN_IDENTITY_FAILURES=10
AUTH_RATE_LIMIT_REGISTER_CLIENT=10
AUTH_RATE_LIMIT_RESEND_CLIENT=30
AUTH_RATE_LIMIT_RESEND_IDENTITY=5
AUTH_RATE_LIMIT_FORGOT_CLIENT=30
AUTH_RATE_LIMIT_FORGOT_IDENTITY=5
AUTH_RATE_LIMIT_VERIFY_CLIENT=30
AUTH_RATE_LIMIT_RESET_CLIENT=30
# Safe here because web-backend has no host ports and Caddy is the sole ingress on jelica-net.
FORWARDED_ALLOW_IPS=*

STORAGE_PATH=/var/lib/jelica/web-storage
# Provisional, deployment-configurable browser upload staging settings.
JELICA_WEB_UPLOAD_ROOT=/var/lib/jelica/web-storage/analysis-uploads
JELICA_UPLOAD_MAX_FILE_BYTES=10737418240
JELICA_UPLOAD_MAX_SESSION_BYTES=107374182400
JELICA_UPLOAD_MAX_SESSION_FILES=10000
JELICA_UPLOAD_MAX_RELATIVE_PATH_LENGTH=1024
JELICA_UPLOAD_SESSION_TTL_SECONDS=86400
JELICA_RUNTIME_PATH=/var/lib/jelica/service
JELICA_CLI_COMMAND_PREFIX=uv run --package jelica-cli jelica
JELICA_CLI_TIMEOUT_SECONDS=120
