{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jelica:documentation-search-index:1",
  "title": "JELICA documentation search index",
  "description": "Stable client contract for generated JELICA documentation search data.",
  "type": "object",
  "required": [
    "schemaVersion",
    "locale",
    "title",
    "version",
    "fieldPriority",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "title": {
      "$ref": "#/$defs/nonBlankString"
    },
    "version": {
      "$ref": "#/$defs/documentationVersion"
    },
    "fieldPriority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/searchDocument"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "documentationVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "anchor": {
      "type": "string",
      "pattern": "^#[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "searchDocument": {
      "type": "object",
      "required": [
        "id",
        "title",
        "headings",
        "keywords",
        "path",
        "anchor",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "headings": {
          "$ref": "#/$defs/stringList"
        },
        "headingAnchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "keywords": {
          "$ref": "#/$defs/stringList"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "content": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "additionalProperties": true
    }
  }
}
